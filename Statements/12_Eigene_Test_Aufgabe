antwort = ""
kontakte = {}   # Name -> Nummer
Nummer_bereich = (3, 15)



while True:
    aktion = input("(h)inzufügen, (a)nzeigen, (s)uchen, (e)ntfernen, (b)eenden? ").lower()
    if aktion == "h":
        kontakt = input("Geben sie die Nummer des gewünschten Kontaktes ein")
        # prüft: min (3) <= Länge UND Länge <= max (15), also ob Nummer zwischen 3 und 15 Ziffern hat
        if Nummer_bereich[0] <= len(kontakt) <= Nummer_bereich[1]:
            kontakt_name = input("wie möchten sie ihren Kontakt benenen ?")
            kontakte[kontakt_name] = kontakt 
        else:
            print("Nummer ungültig versuchen sie es nochmal")
    if aktion == "a":
        print (kontakte)
